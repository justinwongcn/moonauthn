import {
  "justinwongcn/moonauth/core" @core,
}

import {
  "moonbitlang/core/debug",
  "justinwongcn/moonauth/rand" @rand,
  "justinwongcn/moonauth/contract" @contract,
  "justinwongcn/moonauth/store-memory" @store_memory,
  "justinwongcn/moonauth/oauth" @oauth,
  "justinwongcn/moonauth/oidc" @oidc,
  "justinwongcn/moonauth/totp" @totp,
  "justinwongcn/moonauth/passkey" @passkey,
  "justinwongcn/moonauth/provider/google" @google,
  "justinwongcn/moonauth/provider/apple" @apple,
  "justinwongcn/moonauth/provider/x" @x,
  "justinwongcn/moonauth/provider/wechat" @wechat,
  "justinwongcn/moonauth/provider/qq" @qq,
  "justinwongcn/moonauth/provider/alipay" @alipay,
  "moonbitstack/mooncrypt/sign/ecdsa" @ecdsa,
  "moonbitstack/mooncrypt/rsa" @rsa,
  "mizchi/experimental_crypto/webauthn" @webauthn,
  "mizchi/experimental_crypto/cbor" @cbor,
  "mizchi/experimental_crypto/p256" @p256,
  "1726914517-spec/moon_otp" @otp,
  "moonbitlang/core/encoding/utf8" @utf8,
  "moonbitlang/async",
} for "test"

options(supported_targets: "+native+js")
