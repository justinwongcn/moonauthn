import {
  "justinwongcn/moonauthn/core" @core,
}

import {
  "moonbitlang/core/debug",
  "justinwongcn/moonauthn/rand" @rand,
  "justinwongcn/moonauthn/contract" @contract,
  "justinwongcn/moonauthn/store-memory" @store_memory,
  "justinwongcn/moonauthn/oauth" @oauth,
  "justinwongcn/moonauthn/oidc" @oidc,
  "justinwongcn/moonauthn/totp" @totp,
  "justinwongcn/moonauthn/passkey" @passkey,
  "justinwongcn/moonauthn/provider/google" @google,
  "justinwongcn/moonauthn/provider/apple" @apple,
  "justinwongcn/moonauthn/provider/x" @x,
  "justinwongcn/moonauthn/provider/wechat" @wechat,
  "justinwongcn/moonauthn/provider/qq" @qq,
  "justinwongcn/moonauthn/provider/alipay" @alipay,
  "justinwongcn/moonauthn/provider/github" @github,
  "justinwongcn/moonauthn/provider/discord" @discord,
  "justinwongcn/moonauthn/provider/dingtalk" @dingtalk,
  "justinwongcn/moonauthn/provider/feishu" @feishu,
  "justinwongcn/moonauthn/provider/microsoft" @microsoft,
  "moonbitstack/mooncrypt/sign/ecdsa" @ecdsa,
  "moonbitstack/mooncrypt/rsa" @rsa,
  "justinwongcn/experimental_crypto/webauthn" @webauthn,
  "justinwongcn/experimental_crypto/cbor" @cbor,
  "justinwongcn/experimental_crypto/p256" @p256,
  "1726914517-spec/moon_otp" @otp,
  "moonbitlang/core/encoding/utf8" @utf8,
  "moonbitlang/async",
} for "test"

options(supported_targets: "+native+js")
