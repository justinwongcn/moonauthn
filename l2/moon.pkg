import {
  "justinwongcn/moonauthn/core" @core,
  "justinwongcn/moonauthn/provider/google" @google,
  "justinwongcn/moonauthn/provider/microsoft" @microsoft,
  "justinwongcn/moonauthn/provider/github" @github,
  "justinwongcn/moonauthn/provider/discord" @discord,
  "justinwongcn/moonauthn/provider/x" @x,
  "justinwongcn/moonauthn/provider/dingtalk" @dingtalk,
  "justinwongcn/moonauthn/provider/feishu" @feishu,
  "justinwongcn/moonauthn/provider/alipay" @alipay,
  "justinwongcn/moonauthn/provider/wechat" @wechat,
  "justinwongcn/moonauthn/provider/qq" @qq,
  "moonbitlang/core/json" @json,
  "moonbitlang/core/debug",
  "moonbitlang/async",
  "moonbitlang/async/fs" @async_fs,
  "moonbitlang/async/http" @http,
  "moonbitlang/async/socket" @socket,
}

options(supported_targets: "+native")

pkgtype(kind: "executable")
